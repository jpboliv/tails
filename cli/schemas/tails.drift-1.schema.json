{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tails.drift/1",
  "title": "tails.drift/1",
  "description": "Drift findings. tails writes this as drift.json. An agent may write one with extra findings; tails merges it with --extra and labels the source.",
  "type": "object",
  "required": ["schema", "findings"],
  "properties": {
    "schema": { "const": "tails.drift/1" },
    "source": { "type": "string", "description": "Who wrote the findings. tails uses \"tails\"." },
    "commit": { "type": ["string", "null"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "citations"],
        "properties": {
          "rule": { "type": "string", "description": "DR-1 to DR-6 from tails; any other value from an agent." },
          "title": { "type": "string" },
          "severity": { "enum": ["fail", "warn"], "description": "Agent findings are always warn." },
          "message": { "type": "string" },
          "ids": { "type": "array", "items": { "type": "string" } },
          "citations": {
            "type": "array",
            "minItems": 1,
            "description": "Every finding cites a file and line.",
            "items": {
              "type": "object",
              "required": ["doc", "line"],
              "properties": {
                "doc": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "role": { "enum": ["prd", "tdd", "tcs", "doc"] },
                "what": { "type": "string" }
              }
            }
          },
          "fingerprint": { "type": "string" },
          "status": { "enum": ["open", "accepted"] },
          "source": { "type": "string" },
          "accepted": {
            "type": "object",
            "required": ["reason", "by", "date"],
            "properties": { "reason": { "type": "string" }, "by": { "type": "string" }, "date": { "type": "string" } }
          }
        }
      }
    }
  }
}
