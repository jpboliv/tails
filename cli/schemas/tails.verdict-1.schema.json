{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tails.verdict/1",
  "title": "tails.verdict/1",
  "description": "One conformance run on one PR head. A selected skill produces this contract directly or through an adapter.",
  "type": "object",
  "required": ["schema", "checker", "pr", "ticket", "spec", "overall", "results"],
  "properties": {
    "schema": { "const": "tails.verdict/1" },
    "checker": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "pr": {
      "type": "object",
      "required": ["repo", "number", "head_sha"],
      "properties": {
        "repo": { "type": "string" },
        "number": { "type": "integer" },
        "head_sha": { "type": "string" }
      }
    },
    "ticket": { "type": "string" },
    "spec": {
      "type": "object",
      "required": ["repo", "commit"],
      "properties": { "repo": { "type": "string" }, "commit": { "type": "string" } }
    },
    "overall": { "enum": ["conforms", "does_not_conform", "cannot_check"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "verdict": { "enum": ["met", "missing", "deviates", "not_checkable", "blocked"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["spec", "code"],
              "properties": { "spec": { "type": "string" }, "code": { "type": "string" } }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "paths"],
        "properties": {
          "kind": { "enum": ["incidental", "addition", "early_work"] },
          "paths": { "type": "array", "items": { "type": "string" } },
          "ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ids", "spec_says", "pr_does", "who_decides"],
        "properties": {
          "id": { "type": "string" },
          "ids": { "type": "array", "items": { "type": "string" } },
          "spec_says": { "type": "string" },
          "pr_does": { "type": "string" },
          "who_decides": { "type": "string" }
        }
      }
    }
  }
}
